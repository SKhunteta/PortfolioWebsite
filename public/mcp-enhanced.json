{
  "name": "shreyans-portfolio-mcp",
  "version": "2.0.0",
  "description": "AI-powered portfolio intelligence server for Shreyans Khunteta — Senior Software Engineer specializing in C#/.NET, AI, and full-stack development",
  "connection": {
    "mcp_endpoint": "https://backend.builtbyshrey.com/api/mcp-connector",
    "mcp_discovery": "https://backend.builtbyshrey.com/.well-known/mcp.json",
    "transport": "streamable-http",
    "protocol_version": "2025-03-26"
  },
  "rest_api_fallback": {
    "description": "If your system cannot speak MCP, use the REST API instead (simple HTTP GET/POST).",
    "base_url": "https://backend.builtbyshrey.com/api/portfolio",
    "openapi_spec": "https://backend.builtbyshrey.com/api/portfolio/openapi.json",
    "try_it": "https://backend.builtbyshrey.com/api/portfolio/search?q=AI+projects"
  },
  "capabilities": {
    "tools": [
      {
        "name": "portfolio_search",
        "description": "Search portfolio content by topic — projects, skills, experience, personal info",
        "parameters": {
          "type": "object",
          "properties": {
            "query": { "type": "string", "description": "Search query" },
            "contentTypes": {
              "type": "array",
              "items": { "type": "string", "enum": ["project", "skill", "experience", "personal"] },
              "description": "Content types to search"
            }
          },
          "required": ["query"]
        },
        "rest_equivalent": "GET /api/portfolio/search?q=<query>&types=<types>"
      },
      {
        "name": "analyze_portfolio",
        "description": "Analyze how well the portfolio matches specific job requirements",
        "parameters": {
          "type": "object",
          "properties": {
            "jobDescription": { "type": "string", "description": "Job description to analyze against" },
            "requiredSkills": { "type": "array", "items": { "type": "string" } },
            "focusArea": { "type": "string", "description": "Specific area to focus the analysis on" }
          },
          "required": ["jobDescription"]
        },
        "rest_equivalent": "POST /api/portfolio/assess-fit"
      },
      {
        "name": "get_project_details",
        "description": "Get detailed information about a specific portfolio project",
        "parameters": {
          "type": "object",
          "properties": {
            "projectName": { "type": "string", "description": "Name or ID of the project" }
          },
          "required": ["projectName"]
        },
        "rest_equivalent": "GET /api/portfolio/projects/<id>"
      },
      {
        "name": "assess_fit",
        "description": "Structured candidate fit assessment against a job description",
        "parameters": {
          "type": "object",
          "properties": {
            "jobDescription": { "type": "string", "description": "Full job description text" },
            "requiredSkills": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["jobDescription"]
        },
        "rest_equivalent": "POST /api/portfolio/assess-fit"
      },
      {
        "name": "ask_shrey",
        "description": "Ask Shreyans a question — responds as if Shrey were answering, grounded in his actual work",
        "parameters": {
          "type": "object",
          "properties": {
            "question": { "type": "string", "description": "The question to ask" }
          },
          "required": ["question"]
        },
        "rest_equivalent": "POST /api/portfolio/ask"
      }
    ],
    "resources": [
      { "uri": "portfolio://projects", "name": "Projects", "rest_equivalent": "GET /api/portfolio/projects" },
      { "uri": "portfolio://skills", "name": "Skills", "rest_equivalent": "GET /api/portfolio/skills" },
      { "uri": "portfolio://experience", "name": "Experience", "rest_equivalent": "GET /api/portfolio/experience" },
      { "uri": "portfolio://personal", "name": "Personal", "rest_equivalent": "GET /api/portfolio/about" }
    ]
  },
  "context": {
    "professional_focus": "Intersection of traditional software development with cutting-edge AI technologies",
    "portfolio_features": {
      "interactive_ai_assistant": {
        "name": "Kali",
        "capabilities": "Answers questions about Shreyans' work, projects, and expertise in real-time"
      },
      "ai_discoverable": "Site is optimized for AI crawler discovery with REST API, MCP protocol, structured data, and static content fallbacks"
    }
  },
  "metadata": {
    "author": "Shreyans Khunteta",
    "website": "https://builtbyshrey.com",
    "github": "https://github.com/SKhunteta",
    "lastUpdated": "2026-02-26T00:00:00Z",
    "ai_friendly": true,
    "mcp_version": "2.0.0"
  }
}
